# ───── Server ─────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001

# ───── Local demo tooling (optional) ─────
# DEMO_API_KEY is printed once by `npm run seed`; do not commit a real key.
DEMO_API_KEY=
DEMO_HMAC_SECRET=
DEMO_API_URL=http://localhost:3001
DEMO_RECEIVER_URL=http://127.0.0.1:3002

# ───── Database ─────
# Local:   mongodb://localhost:27017/hookrelay
# Atlas:   mongodb+srv://user:password@cluster.example.mongodb.net/hookrelay
DATABASE_URL=mongodb://localhost:27017/hookrelay

# ───── Queue ─────
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=10

# ───── Auth ─────
JWT_SECRET=replace_me_with_a_long_random_string

# ───── Webhook signing ─────
HMAC_DEFAULT_SECRET=replace_me_with_a_long_random_string

# ───── Stripe (billing) ─────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxx
STRIPE_TEAM_PRICE_ID=price_xxxxxxxxxxxxxxxx