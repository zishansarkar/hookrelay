{
  "name": "@hookrelay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean && npm run build --workspace=@hookrelay/shared",
    "dev": "tsx watch src/server.ts",
    "dev:nodemon": "nodemon --watch src --ext ts,json --exec \"tsx src/server.ts\"",
    "build": "tsc",
    "db:check": "tsx src/scripts/db-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prestart": "npm run build --workspace=@hookrelay/shared",
    "start": "node dist/server.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@hookrelay/shared": "*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "pino": "^10.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "mongodb-memory-server": "^11.3.0",
    "nock": "^15.0.5",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
