{
  "name": "@hookrelay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean && npm run build --workspace=@hookrelay/shared",
    "dev": "tsx watch src/server.ts",
    "dev:nodemon": "nodemon --watch src --ext ts,json --exec \"tsx src/server.ts\"",
    "build": "tsc",
    "prestart": "npm run build --workspace=@hookrelay/shared",
    "start": "node dist/server.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@hookrelay/shared": "*",
    "bullmq": "^6.4.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "pino": "^10.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15"
  }
}
